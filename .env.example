# Example environment file for IDS-DRR-QA-Automation
# Copy this to .env and fill in real values locally (do NOT commit .env)

# Environment Configuration
LOCAL=true
REMOTE_LINK=

# Application URLs
# Production URL
URL=

# Development URL (optional - takes precedence over URL if set)
# Example: DEV_URL=https://your-dev-environment.com/
#DEV_URL=

HOME_URL_4=
MEDIUM_URL=https://medium.com

# Authentication (example placeholders — set real values in .env)
HOME_URL_USERNAME=your-username
HOME_URL_PASSWORD=your-password

# Personal access token for repository dispatch / automation
# Store in GitHub Secrets for CI; only put in .env for local testing
QA_REPO_PAT=ghp_xxx_replace_with_secret

# Browser Settings (optional, defaults provided)
HEADLESS=false
WINDOW_WIDTH=1920
WINDOW_HEIGHT=1080

# Timeout Settings (in seconds) — optimized for performance
DEFAULT_TIMEOUT=10     # Element wait timeout (default: 20, recommended: 8-10)
SHORT_TIMEOUT=5        # Quick checks (default: 10, recommended: 3-5)
LONG_TIMEOUT=15        # Slow operations (default: 30, recommended: 15-20)

# Additional Performance Settings
PAGE_LOAD_TIMEOUT=30   # Maximum page load wait
IMPLICIT_WAIT=1        # Implicit wait for elements (0-2 seconds recommended)
