# Environment Configuration
LOCAL=true
REMOTE_LINK=

# Application URLs
# Production URL
URL=

# Development URL (optional - takes precedence over URL if set)
# Uncomment and set for testing against development environment
# Example: DEV_URL='https://drr-dev.open-contracting.in/'
#DEV_URL=

HOME_URL_4=
MEDIUM_URL=https://medium.com

# Authentication
HOME_URL_USERNAME=
HOME_URL_PASSWORD=

# Browser Settings (optional, defaults provided)
HEADLESS=false
WINDOW_WIDTH=1920
WINDOW_HEIGHT=1080

# Timeout Settings (in seconds) - OPTIMIZED FOR PERFORMANCE
# Recommended: Reduce these for faster test execution
DEFAULT_TIMEOUT=10     # Element wait timeout (default: 20, recommended: 8-10)
SHORT_TIMEOUT=5        # Quick checks (default: 10, recommended: 3-5)
LONG_TIMEOUT=15        # Slow operations (default: 30, recommended: 15-20)

# Additional Performance Settings
PAGE_LOAD_TIMEOUT=30   # Maximum page load wait
IMPLICIT_WAIT=1        # Implicit wait for elements (0-2 seconds recommended)
